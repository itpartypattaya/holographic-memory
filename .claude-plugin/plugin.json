{
  "name": "holographic-memory",
  "version": "0.8.1",
  "description": "Long-term local memory for Claude Code: a SQLite fact store with trust scoring and holographic recall, recalled before each turn, with memory tools over MCP. Runs from the plugin folder through uv; Claude Code only.",
  "author": {"name": "itpartypattaya"},
  "homepage": "https://github.com/itpartypattaya/holographic-memory",
  "repository": "https://github.com/itpartypattaya/holographic-memory",
  "license": "MIT",
  "keywords": ["memory", "sqlite", "fts5", "recall", "mcp"],
  "documentationUrl": "https://github.com/itpartypattaya/holographic-memory#readme",
  "supportUrl": "https://github.com/itpartypattaya/holographic-memory/issues",
  "privacyPolicyUrl": "https://github.com/itpartypattaya/holographic-memory/blob/main/PRIVACY.md",
  "mcpServers": {
    "holographic": {
      "command": "uv",
      "args": ["run", "--locked", "--quiet", "--project", "${CLAUDE_PLUGIN_ROOT}", "holomem", "mcp", "--client", "claude-code"]
    }
  }
}
